{
  "info": {
    "name": "ClubHire API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman keeps the session cookie automatically after Login. Log in as a student or an admin first. Replace :id values with real ids from the list responses."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"test@student.rvce.edu.in\",\n  \"password\": \"password123\",\n  \"usn\": \"1RV24CS099\",\n  \"branch\": \"CSE\",\n  \"year\": 2,\n  \"skills\": \"Python, CAD\"\n}"
            }
          }
        },
        {
          "name": "Login (student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@rvce.edu.in\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (Coding Club admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"coding@rvce.edu.in\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Openings",
      "item": [
        {
          "name": "List clubs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clubs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clubs"
              ]
            }
          }
        },
        {
          "name": "List openings (search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/openings?q=python",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "openings"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "python"
                }
              ]
            }
          }
        },
        {
          "name": "My club's openings (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/openings?mine=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "openings"
              ],
              "query": [
                {
                  "key": "mine",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get one opening",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/openings/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "openings",
                ":id"
              ]
            }
          }
        },
        {
          "name": "Create opening (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/openings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "openings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ground Station Developer\",\n  \"description\": \"Build the dashboard that shows club members, events and attendance.\",\n  \"skills\": \"JavaScript, Node.js\",\n  \"deadline\": \"2026-12-01T23:59:00\"\n}"
            }
          }
        },
        {
          "name": "Update / close opening (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/openings/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "openings",
                ":id"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isOpen\": false\n}"
            }
          }
        },
        {
          "name": "Delete opening (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/openings/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "openings",
                ":id"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Apply (student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/openings/:id/apply",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "openings",
                ":id",
                "apply"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I have built web dashboards before and would love to work on the ground station.\"\n}"
            }
          }
        },
        {
          "name": "My applications (student)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "mine"
              ]
            }
          }
        },
        {
          "name": "Withdraw (student)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                ":id"
              ]
            }
          }
        },
        {
          "name": "Applicants for opening (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/openings/:id/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "openings",
                ":id",
                "applications"
              ]
            }
          }
        },
        {
          "name": "Move status (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/:id/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                ":id",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Shortlisted\",\n  \"note\": \"Interview on Friday 4 PM\"\n}"
            }
          }
        }
      ]
    }
  ]
}